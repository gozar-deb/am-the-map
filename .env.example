# Am the Map -- environment configuration
# Copy to .env and edit. Nothing here is required to run the platform --
# the simulator + baseline model work with zero keys.

# --- General ---
ENVIRONMENT=development
DATA_DIR=data
DATABASE_URL=sqlite:///./data/am_the_map.db

# --- Sensing ---
DEFAULT_SAMPLING_HZ=20
SIMULATOR_ENABLED=true

# --- Voxel mapping (section 8) ---
VOXEL_RESOLUTION_M=0.20
# room_bounds_m is a tuple in code; override via ROOM_BOUNDS_M="[5.0,5.0,3.0]" if needed

# --- AI Gateway (sections 18-21) ---
# AI_MODE: local | hybrid | cloud | offline
AI_MODE=offline
# PRIVACY_MODE=true disables ALL external AI calls regardless of AI_MODE
PRIVACY_MODE=true
AI_DEFAULT_PROVIDER=none

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
CUSTOM_LOCAL_ENDPOINT=

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Optional shared secret. Leave empty for open local use.
# When set, clients must send: Authorization: Bearer <token>  or  X-API-Token: <token>
API_TOKEN=
# AI ask rate limit (requests per minute)
AI_RATE_LIMIT_PER_MINUTE=30

# --- Frontend (read by frontend/vite, not the backend) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
# Optional; set to same value as API_TOKEN when auth is enabled
VITE_API_TOKEN=

# --- CLI ---
AM_MAP_API_URL=http://localhost:8000
# Same value as API_TOKEN when auth is enabled
AM_MAP_API_TOKEN=
